<?xml version="1.0" encoding="utf-8"?>
<!-- بعض سيرفرات Xtream Codes تعمل عبر HTTP فقط (بدون TLS) — نسمح بذلك صراحة هنا -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
